// Layout of the poster studio: a tool rail, a panel that slides in, and the
// stage with the poster. On phones the rail becomes a tab bar and panels
// become a bottom sheet.
.studio {
  display: grid;
  grid-template-columns: 84px auto minmax(0, 1fr);
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  // "clip" also stops focus or find-in-page from scrolling the studio sideways.
  overflow: clip;

  .rail {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 8px;
    background: white;
    border-right: 1px solid var(--line);
    z-index: 3;
  }

  .tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--muted-ink);
    padding: 10px 4px 8px;
    font-size: 11.5px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, transform 0.12s;
    &:hover {
      color: var(--ink);
      background: var(--soft);
    }
    &:active {
      transform: scale(0.94);
    }
    &.active {
      color: white;
      background: var(--ink);
    }
  }

  .panel {
    grid-column: 2;
    width: 340px;
    background: white;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-height: 0;
    z-index: 2;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 12px 4px 20px;
    h2 {
      margin: 0;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 600;
      font-size: 24px;
    }
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 4px 20px 28px;
    overscroll-behavior: contain;
  }

  .stage {
    grid-column: 3;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: radial-gradient(circle at 50% 30%, #f6f4f0, #e2ddd5);
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
  }

  .subject {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .subject-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 22px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .size-chip {
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    padding: 4px 10px;
    font-size: 12.5px;
    color: var(--muted-ink);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    &:hover {
      color: var(--ink);
    }
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .download-button {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 8px;
    border: 0;
    border-radius: 14px;
    background: var(--brand);
    color: white;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 16px;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(225, 6, 0, 0.3);
    transition: transform 0.12s, filter 0.15s;
    &:hover {
      filter: brightness(1.08);
    }
    &:active {
      transform: scale(0.96);
    }
  }

  .canvas-area {
    flex: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-bottom: 70px;
  }

  &.narrow.panel-open .canvas-area {
    padding-bottom: 0;
  }

  .poster-holder {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1), 0 24px 50px rgba(0, 0, 0, 0.22);
    transition: width 0.3s cubic-bezier(0.3, 1, 0.5, 1), height 0.3s cubic-bezier(0.3, 1, 0.5, 1);
    &.screen {
      border-radius: 14px;
      overflow: hidden;
    }
  }

  .poster-canvas {
    display: block;
    touch-action: none;
    cursor: grab;
    &:active {
      cursor: grabbing;
    }
    &.selecting {
      cursor: crosshair;
    }
  }

  .data-status {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100% - 24px);
    background: white;
    color: var(--ink);
    font-size: 13.5px;
    padding: 8px 10px 8px 14px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    z-index: 4;
    span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    button {
      border: 0;
      border-radius: 999px;
      background: var(--soft);
      color: var(--ink);
      padding: 6px 12px;
      font-size: 13px;
      cursor: pointer;
      flex-shrink: 0;
    }
    .retry {
      background: var(--brand);
      color: white;
      font-weight: 600;
    }
    &.error {
      white-space: normal;
    }
  }

  .spinner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--line);
    border-top-color: var(--brand);
    animation: studio-spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes studio-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .toast {
    position: absolute;
    top: 56px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(23, 23, 26, 0.88);
    color: white;
    font-size: 13.5px;
    padding: 9px 16px;
    border-radius: 999px;
    pointer-events: none;
    white-space: nowrap;
    max-width: 92%;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(8px);
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
    z-index: 4;
  }

  .dock-button {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.12s;
    &:hover {
      background: var(--soft);
    }
    &:active {
      transform: scale(0.9);
    }
    &.active {
      background: var(--brand);
      color: white;
    }
  }

  .zoom-label {
    border: 0;
    background: transparent;
    min-width: 52px;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    color: var(--ink);
  }

  .dock-divider {
    width: 1px;
    height: 24px;
    background: var(--line);
    margin: 0 4px;
  }

  // Panel transitions
  .slide-enter-active, .slide-leave-active {
    transition: transform 0.28s cubic-bezier(0.3, 1, 0.5, 1), opacity 0.2s;
  }
  .slide-enter-from, .slide-leave-to {
    transform: translateX(-24px);
    opacity: 0;
  }
  .pop-enter-active, .pop-leave-active {
    transition: transform 0.22s cubic-bezier(0.3, 1.3, 0.6, 1), opacity 0.18s;
  }
  .pop-enter-from, .pop-leave-to {
    transform: translateY(-8px) scale(0.97);
    opacity: 0;
  }
}

// Phones and small tablets: tab bar at the bottom, panels as a bottom sheet.
.studio.narrow {
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: 1fr auto;

  .rail {
    grid-column: 1;
    grid-row: 2;
    flex-direction: row;
    overflow-x: auto;
    padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
    border-right: 0;
    border-top: 1px solid var(--line);
    scrollbar-width: none;
    &::-webkit-scrollbar {
      display: none;
    }
  }

  .tool {
    flex: 1 0 54px;
    font-size: 11px;
    padding: 8px 2px 6px;
  }

  .stage {
    grid-column: 1;
    grid-row: 1;
  }

  .panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(72px + env(safe-area-inset-bottom));
    width: auto;
    height: 50dvh;
    border-right: 0;
    border-radius: 22px 22px 0 0;
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.2);
    z-index: 5;
  }

  &.panel-open .stage {
    // Keep the poster visible above the sheet.
    padding-bottom: 50dvh;
  }

  &.panel-open .dock {
    display: none;
  }

  .grabber {
    width: 44px;
    height: 5px;
    border-radius: 3px;
    background: var(--line);
    margin: 8px auto 0;
    cursor: pointer;
  }

  .panel-header {
    padding-top: 6px;
  }

  .topbar {
    padding: 8px 8px 4px;
  }

  .subject-name {
    font-size: 19px;
  }

  .download-button span {
    display: none;
  }

  .download-button {
    padding: 10px 12px;
    margin-left: 4px;
  }

  .dock {
    bottom: 12px;
  }

  .export-sheet {
    top: auto;
    bottom: 12px;
    left: 12px;
    right: 12px;
    width: auto;
    max-width: none;
  }

  .sheet-enter-active, .sheet-leave-active {
    transition: transform 0.3s cubic-bezier(0.3, 1, 0.5, 1);
  }
  .sheet-enter-from, .sheet-leave-to {
    transform: translateY(100%);
  }
}

@media (max-width: 420px) {
  .studio .size-chip {
    display: none;
  }
}
