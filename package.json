{
  "name": "city-roads",
  "version": "1.0.0",
  "description": "Draw every road in a city, or make posters and wallpapers of race circuits",
  "author": "Andrei Kashcha",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tracks": "node scripts/tracks/build-tracks.mjs",
    "tracks:sheet": "node scripts/tracks/contact-sheet.mjs > tracks.svg",
    "lint": "eslint . --ext .vue,.js,.mjs --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.mjs --ignore-path .gitignore",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "^3.0.1",
    "d3-require": "^1.3.0",
    "ngraph.events": "^1.2.1",
    "pbf": "^3.2.1",
    "query-state": "^4.3.0",
    "tinycolor2": "^1.4.2",
    "vue": "3.5",
    "w-gl": "^0.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^8.5.0",
    "eslint-plugin-vue": "^9.33.0",
    "flag-icons": "^7.6.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylus": "^0.64.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  }
